# User unit for the always-on runner (#180). Install notes:
# docs/deployment.md, "Always-On Runner".
# A user unit cannot order itself after the system manager's network
# targets, so there is no After=network-online.target here; the script
# waits for production to be reachable instead.
[Unit]
Description=CS2-analytics daily discovery and processing

[Service]
Type=oneshot
WorkingDirectory=%h/Code/CS2-analytics
ExecStart=%h/Code/CS2-analytics/deploy/systemd/cs2a-daily.sh
# The browser must report the egress region's zone to pass the source's
# challenge (#194); the host clock is set to it, this makes it explicit.
Environment=TZ=America/Chicago
# A catch-up drain after missed days can run for hours.
TimeoutStartSec=6h
