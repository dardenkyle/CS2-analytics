# Local development environment. Copy this file to `.env.dev`.
#
# `.env.dev` is the `dev` environment and the default for every command.
# It must point at a local database: dev refuses any other DB_HOST.
# Deployed credentials go in a separate, gitignored `.env.prod`, which is
# read only when selected with `cs2a --env prod` (or CS2A_ENV=prod for
# `python run_api.py`, `python manage_db.py`, and direct `alembic` calls).
# The test suite always uses the committed `.env.test`. A plain `.env` is
# not read and is rejected so a stale one cannot be mistaken for config.

# Runtime Environment
# Use development for local work. Production fails fast unless all required
# runtime settings below are explicitly provided.
ENVIRONMENT=development
DEBUG_MODE=true

# API Runtime
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501,http://127.0.0.1:8501

# PostgreSQL
# cs2_dev is the development database; cs2_test in the same container
# belongs to the test suite, which truncates tables.
DB_NAME=cs2_dev
DB_USER=postgres
DB_PASS=change_me
DB_HOST=localhost
DB_PORT=5432

# dbt connection (default `dev` target).
# dbt uses its own DBT_DB_* variables so it stays decoupled from the DB_*
# variables above, which may point at a deployed database. These default to a
# local Postgres (matching docker-compose's `db` service), so a bare
# `dbt run` never touches a deployed database. Override to point elsewhere.
# dbt reads the process environment, not this file, so these lines only
# take effect when exported; the profile's own defaults match them.
# The committed `prod` target reads DB_* from the process environment and is
# only used with an explicit `dbt run --target prod`.
DBT_DB_NAME=cs2_dev
DBT_DB_USER=postgres
DBT_DB_PASS=change_me
DBT_DB_HOST=localhost
DBT_DB_PORT=5432

# Optional: override the results discovery URL used by the results scraper.
# Defaults to the built-in results source when unset.
# SOURCE_URL=

# Optional Docker Compose host port for the local PostgreSQL container.
# The application container still connects to DB_HOST=db and DB_PORT=5432.
POSTGRES_HOST_PORT=5432

# Optional: GitHub issue helper scripts
# Create a Personal Access Token at https://github.com/settings/tokens with repo scope.
GITHUB_TOKEN=
